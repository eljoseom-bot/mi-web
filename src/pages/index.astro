---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Agencia SEO Profesional</title>

  <style>
    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0b1220;
      color: white;
    }

    /* ===== HERO ===== */
    .hero {
      text-align: center;
      padding: 120px 20px;
      background: linear-gradient(135deg, #0ea5e9, #1e3a8a);
      animation: fadeDown 1s ease-out;
    }

    .hero h1 {
      font-size: 48px;
      margin-bottom: 10px;
    }

    .hero p {
      opacity: 0.9;
      font-size: 18px;
    }

    /* BOTÓN PRO */
    .btn {
      display: inline-block;
      margin-top: 25px;
      padding: 14px 24px;
      background: #22c55e;
      color: white;
      text-decoration: none;
      border-radius: 10px;
      font-weight: bold;
      transition: all 0.3s ease;
      box-shadow: 0 0 0 transparent;
    }

    .btn:hover {
      transform: scale(1.05);
      box-shadow: 0 0 20px rgba(34, 197, 94, 0.6);
    }

    /* ===== SECCIONES ===== */
    .section {
      padding: 80px 20px;
      text-align: center;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      margin-top: 40px;
    }

    .card {
      background: #111827;
      padding: 25px;
      border-radius: 14px;
      transition: transform 0.3s ease, background 0.3s ease;
      opacity: 0;
      transform: translateY(30px);
      animation: fadeUp 0.8s ease forwards;
    }

    .card:hover {
      transform: translateY(-8px);
      background: #1f2937;
    }

    .card:nth-child(1) { animation-delay: 0.2s; }
    .card:nth-child(2) { animation-delay: 0.4s; }
    .card:nth-child(3) { animation-delay: 0.6s; }

    .sobre, .contacto {
      background: #0f172a;
    }

    footer {
      text-align: center;
      padding: 20px;
      background: #020617;
      font-size: 14px;
    }

    /* ===== ANIMACIONES ===== */
    @keyframes fadeDown {
      from {
        opacity: 0;
        transform: translateY(-30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>

<body>

  <header class="hero">
    <h1>🚀 Consultor de SEO Profesional</h1>
    <p>Posicionamos tu negocio en Google y aumentamos tus clientes</p>

    <a href="/servicios" class="btn">
      Quiero mejorar mi SEO
    </a>
  </header>

  <section class="section">
    <h2>Servicios</h2>

    <div class="grid">
      <div class="card">
        <h3>📈 SEO On-Page</h3>
        <p>Optimización completa de tu web para Google.</p>
      </div>

      <div class="card">
        <h3>🔗 Link Building</h3>
        <p>Autoridad real con enlaces de calidad.</p>
      </div>

      <div class="card">
        <h3>🔍 Auditoría SEO</h3>
        <p>Detectamos todo lo que te está frenando.</p>
      </div>
    </div>
  </section>

  <section class="section sobre">
    <h2>¿Por qué nosotros?</h2>
    <p>Estrategias SEO reales que generan clientes, no promesas vacías.</p>
  </section>

  <section class="section contacto" id="contacto">
    <h2>Contacto</h2>
    <p>Te hacemos una auditoría gratuita</p>
    <a class="btn" href="mailto:contacto@tuweb.com">Enviar Email</a>
  </section>

  <footer>
    © 2026 Agencia SEO
  </footer>

</body>
</html>